+    SchoolEndpointAuthority("POST", "/school/curriculum/{session_id}/masterclass/start", "start_school_curriculum_masterclass", "app.services.school_rebuild_masterclass"),
+    SchoolEndpointAuthority("GET", "/school/masterclass/{session_id}", "get_school_masterclass", "app.services.school_rebuild_masterclass"),
+    SchoolEndpointAuthority("POST", "/school/masterclass/{session_id}/answer", "answer_school_masterclass", "app.services.school_rebuild_masterclass"),
+    SchoolEndpointAuthority("POST", "/school/curriculum/{session_id}/resume-masterclass", "resume_school_curriculum_masterclass", "app.services.school_rebuild_masterclass"),
+    SchoolEndpointAuthority("POST", "/school/curriculum/{session_id}/abandon-masterclass", "abandon_school_curriculum_masterclass", "app.services.school_rebuild_masterclass"),
+    SchoolEndpointAuthority("GET", "/school/support/{session_id}", "get_school_support", "app.services.school_rebuild_support"),
+    SchoolEndpointAuthority("GET", "/school/onboarding", "school_onboarding", "app.services.school_rebuild_profile"),
+    SchoolEndpointAuthority("POST", "/school/onboarding", "save_school_onboarding", "app.services.school_rebuild_profile"),
+    SchoolEndpointAuthority("POST", "/school/onboarding/complete", "complete_school_onboarding", "app.services.school_rebuild_profile"),
+    SchoolEndpointAuthority("POST", "/school/placement/start", "start_school_placement", "app.services.school_rebuild_placement"),
+    SchoolEndpointAuthority("GET", "/school/placement/report", "get_school_placement_report", "app.services.school_rebuild_report"),
+    SchoolEndpointAuthority("GET", "/school/placement/{session_id}", "get_school_placement", "app.services.school_rebuild_placement"),
+    SchoolEndpointAuthority("POST", "/school/placement/{session_id}/answer", "answer_school_placement", "app.services.school_rebuild_placement"),
+    SchoolEndpointAuthority("POST", "/school/placement/{session_id}/abandon", "abandon_school_placement", "app.services.school_rebuild_placement"),
+    SchoolEndpointAuthority("POST", "/school/recap/start", "start_school_recap", "app.services.school_rebuild_recap"),
+    SchoolEndpointAuthority("GET", "/school/recap", "get_active_school_recap", "app.services.school_rebuild_recap"),
+    SchoolEndpointAuthority("POST", "/school/recap/{session_id}/answer", "answer_school_recap", "app.services.school_rebuild_recap"),
+    SchoolEndpointAuthority("GET", "/school/recap/{session_id}", "get_school_recap", "app.services.school_rebuild_recap"),
+    *(
+        SchoolEndpointAuthority(
+            method,
+            path,
+            endpoint_name,
+            "app.api.school_retirement_routes",
+        )
+        for method, path, endpoint_name in RETIRED_SCHOOL_ENDPOINT_SPECS
+    ),
+)
+
+DISABLED_SCHOOL_AUTHORITY: tuple[SchoolEndpointAuthority, ...] = (
+    SchoolEndpointAuthority(
+        "GET",
+        "/school/state",
+        "school_availability_state",
+        "app.services.school.availability",
+    ),
+    *(
+        SchoolEndpointAuthority(
+            method,
+            path,
+            endpoint_name,
+            "app.api.school_retirement_routes",
+        )
+        for method, path, endpoint_name in RETIRED_SCHOOL_ENDPOINT_SPECS
+    ),
+)
+
+
+def school_route_owner(owning_service: str):
+    """Mark a route handler with its independently declared service owner."""
+
+    def decorate(endpoint):
+        setattr(endpoint, SCHOOL_ROUTE_OWNER_ATTRIBUTE, owning_service)
+        return endpoint
+
+    return decorate
+
+
+def _school_registrations(
+    routes: Iterable[object],
+) -> tuple[tuple[str, str, str, str | None], ...]:
+    registrations: list[tuple[str, str, str, str | None]] = []
+    active_containers: set[int] = set()
+
+    def walk(nested_routes: Iterable[object], prefix: str = "") -> None:
+        for route in nested_routes:
+            route_path = str(getattr(route, "path", "") or "")
+            effective_path = _join_route_path(prefix, route_path)
+            methods = getattr(route, "methods", None)
+            child_routes = getattr(route, "routes", None)
+
+            if _is_school_path(effective_path) and not methods:
+                raise ValueError(
+                    f"canonical_school_non_http_route:{effective_path}"
+                )
+
+            if methods and _is_school_path(effective_path):
+                endpoint = getattr(route, "endpoint", None)
+                endpoint_name = str(getattr(endpoint, "__name__", ""))
+                owner = getattr(endpoint, SCHOOL_ROUTE_OWNER_ATTRIBUTE, None)
+                for method in sorted(methods):
+                    if method not in {"HEAD", "OPTIONS"}:
+                        registrations.append(
+                            (method, effective_path, endpoint_name, owner)
+                        )
+
+            if child_routes is not None and id(route) not in active_containers:
+                active_containers.add(id(route))
+                try:
+                    walk(child_routes, effective_path)
+                finally:
+                    active_containers.remove(id(route))
+
+    walk(routes)
+    return tuple(registrations)
+
+
+def _join_route_path(prefix: str, path: str) -> str:
+    if path in {"", "/"}:
+        return prefix or ("/" if path == "/" else "")
+    if prefix in {"", "/"}:
+        return f"/{path.lstrip('/')}"
+    return f"{prefix.rstrip('/')}/{path.lstrip('/')}"
+
+
+def _is_school_path(path: str) -> bool:
+    return path == "/school" or path.startswith("/school/")
+
+
+def validate_canonical_school_routes(
+    routes: Iterable[object],
+    *,
+    school_enabled: bool = True,
+) -> None:
+    """Fail startup when mounted School registrations drift from authority."""
+
+    expected_authority = (
+        CANONICAL_SCHOOL_AUTHORITY if school_enabled else DISABLED_SCHOOL_AUTHORITY
+    )
+    expected_keys = tuple(entry.route_key for entry in expected_authority)
+    if len(expected_keys) != len(set(expected_keys)):
+        raise ValueError("duplicate_canonical_school_authority")
+    for entry in expected_authority:
+        if not entry.owning_service.startswith("app."):
+            raise ValueError(
+                f"canonical_school_owner_import_error:{entry.owning_service}"
+            )
+        try:
+            importlib.import_module(entry.owning_service)
+        except ImportError as exc:
+            raise ValueError(
+                f"canonical_school_owner_import_error:{entry.owning_service}"
+            ) from exc
+
+    actual = _school_registrations(routes)
+    actual_keys = tuple((method, path) for method, path, _name, _owner in actual)
+    if len(actual_keys) != len(set(actual_keys)):
+        raise ValueError("duplicate_canonical_school_route")
+    if set(actual_keys) != set(expected_keys):
+        missing = sorted(set(expected_keys) - set(actual_keys))
+        unexpected = sorted(set(actual_keys) - set(expected_keys))
+        raise ValueError(
+            f"canonical_school_route_mismatch:missing={missing}:unexpected={unexpected}"
+        )
+    expected_by_key = {
+        entry.route_key: entry for entry in expected_authority
+    }
+    for method, path, endpoint_name, owner in actual:
+        expected = expected_by_key[(method, path)]
+        if endpoint_name != expected.endpoint_name:
+            raise ValueError(
+                "canonical_school_route_mismatch:"
+                f"{method}:{path}:expected={expected.endpoint_name}:actual={endpoint_name}"
+            )
+        if owner != expected.owning_service:
+            raise ValueError(
+                "canonical_school_route_owner_mismatch:"
+                f"{method}:{path}:expected={expected.owning_service}:actual={owner}"
+            )
+
+
+__all__ = [
+    "CANONICAL_SCHOOL_AUTHORITY",
+    "DISABLED_SCHOOL_AUTHORITY",
+    "SCHOOL_ROUTE_OWNER_ATTRIBUTE",
+    "RETIRED_SCHOOL_ENDPOINT_SPECS",
+    "SchoolEndpointAuthority",
+    "school_route_owner",
+    "validate_canonical_school_routes",
+]
diff --git a/app/services/school/availability.py b/app/services/school/availability.py
new file mode 100644
index 0000000000000000000000000000000000000000..8272d76c6a3f67b037ff8aa205aedd7144f4c704
--- /dev/null
+++ b/app/services/school/availability.py
@@ -0,0 +1,185 @@
+"""Fail-closed availability gate for the canonical School runtime."""
+
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass
+import hashlib
+import json
+import logging
+
+from app.config import get_settings
+
+
+EXPECTED_RELEASE_CHAPTERS = 47
+logger = logging.getLogger("zidd.school.availability")
+
+
+@dataclass(frozen=True)
+class SchoolAvailability:
+    available: bool
+    reason: str | None
+    expected_chapters: int
+    authored_chapters: int
+    human_approved_chapters: int
+    release_digest: str | None
+
+    def public_dict(self) -> dict:
+        return asdict(self)
+
+
+def _release_closure() -> SchoolAvailability:
+    # Keep disabled School completely outside the Career boot dependency graph.
+    # These modules discover and validate the authored corpus at import time.
+    from app.content.school.source_map_compat import load_beta_source_map
+    from app.content.school_rebuild_content import (
+        LIVE_CHAPTER_ROOT,
+        load_live_chapter_file,
+    )
+
+    expected_ids: set[str] = set()
+    for class_no in range(2, 6):
+        source_map = load_beta_source_map("english", class_no)
+        expected_ids.update(
+            str(chapter.get("chapter_id") or "")
+            for chapter in source_map.get("chapters") or []
+            if str(chapter.get("chapter_id") or "")
+        )
+
+    authored_paths = sorted((LIVE_CHAPTER_ROOT / "english").glob("class_*/*.json"))
+    authored = [load_live_chapter_file(path) for path in authored_paths]
+    authored_ids = {chapter.chapter_id for chapter in authored}
+    approved_ids = {
+        chapter.chapter_id
+        for chapter in authored
+        if chapter.approval_status == "human_approved"
+    }
+    closure_rows = sorted(
+        (
+            chapter.chapter_id,
+            chapter.runtime_sha256,
+            chapter.approval_status,
+            chapter.reviewed_by,
+            chapter.reviewed_at,
+            tuple(chapter.review_evidence),
+        )
+        for chapter in authored
+    )
+    digest = hashlib.sha256(
+        json.dumps(closure_rows, separators=(",", ":"), ensure_ascii=True).encode("utf-8")
+    ).hexdigest()
+
+    if (
+        len(expected_ids) != EXPECTED_RELEASE_CHAPTERS
+        or len(authored_ids) != EXPECTED_RELEASE_CHAPTERS
+        or authored_ids != expected_ids
+    ):
+        return SchoolAvailability(
+            False,
+            "school_release_chapter_closure_incomplete",
+            len(expected_ids),
+            len(authored_ids),
+            len(approved_ids),
+            digest,
+        )
+    if (
+        len(approved_ids) != EXPECTED_RELEASE_CHAPTERS
+        or approved_ids != expected_ids
+    ):
+        return SchoolAvailability(
+            False,
+            "school_release_human_approval_incomplete",
+            len(expected_ids),
+            len(authored_ids),
+            len(approved_ids),
+            digest,
+        )
+    trusted_digest = get_settings().school_release_attestation_sha256.strip().lower()
+    if not trusted_digest or trusted_digest != digest:
+        return SchoolAvailability(
+            False,
+            "school_release_attestation_mismatch",
+            len(expected_ids),
+            len(authored_ids),
+            len(approved_ids),
+            digest,
+        )
+    return SchoolAvailability(
+        True,
+        None,
+        len(expected_ids),
+        len(authored_ids),
+        len(approved_ids),
+        digest,
+    )
+
+
+def school_availability() -> SchoolAvailability:
+    settings = get_settings()
+    if not settings.school_enabled:
+        return SchoolAvailability(
+            False,
+            "school_disabled",
+            EXPECTED_RELEASE_CHAPTERS,
+            0,
+            0,
+            None,
+        )
+    if settings.app_env.strip().lower() not in {"prod", "production"}:
+        return SchoolAvailability(
+            True,
+            None,
+            EXPECTED_RELEASE_CHAPTERS,
+            0,
+            0,
+            None,
+        )
+    try:
+        return _release_closure()
+    except Exception:
+        logger.exception("School release validation failed; disabling School runtime")
+        return SchoolAvailability(
+            False,
+            "school_release_validation_failed",
+            EXPECTED_RELEASE_CHAPTERS,
+            0,
+            0,
+            None,
+        )
+
+
+def unavailable_school_state(
+    availability: SchoolAvailability | None = None,
+) -> dict:
+    availability = availability or school_availability()
+    return {
+        "available": False,
+        "availability_reason": availability.reason,
+        "profile_status": "missing",
+        "target_class_no": None,
+        "subject_id": None,
+        "profile_version_id": None,
+        "preferred_teaching_language": None,
+        "coach_avatar_id": None,
+        "coach_palette_id": None,
+        "active_flow": "none",
+        "active_session_id": None,
+        "placement_status": "not_started",
+        "unlock_state": "locked",
+        "evaluated_class_no": None,
+        "active_learning_class_no": None,
+        "status": "recoverable_error",
+        "next_action": None,
+        "next_action_url": "/career",
+        "allowed_next_actions": [],
+        "learner_message": "School prep is not available in this release.",
+        "parent_message": "School prep is not available in this release.",
+        "blocked_reason": availability.reason,
+    }
+
+
+__all__ = [
+    "EXPECTED_RELEASE_CHAPTERS",
+    "SchoolAvailability",
+    "school_availability",
+    "unavailable_school_state",
+]
diff --git a/app/services/school/open_answer_ai.py b/app/services/school/open_answer_ai.py
new file mode 100644
index 0000000000000000000000000000000000000000..7d5cc005a4665116794eb7493007672e5d0f6fd0
--- /dev/null
+++ b/app/services/school/open_answer_ai.py
@@ -0,0 +1,50 @@
+"""Isolated provider boundary for canonical School open-answer evaluation."""
+
+from __future__ import annotations
+
+from app.ai.clients import get_gemini_client
+from app.ai.local import ollama_structured
+from app.ai.structured import call_with_structured_output
+from app.config import get_settings
+from app.content.school.content_schema import SchoolRubricEvaluation
+from app.middleware.rate_limit import llm_semaphore
+from app.services.school.open_answer_prompt import build_school_open_answer_prompt
+
+
+def _local() -> bool:
+    return get_settings().ai_backend == "local"
+
+
+async def evaluate_school_open_answer(
+    activity: dict,
+    answer: str,
+) -> SchoolRubricEvaluation:
+    """Evaluate one School long-writing answer with one provider call."""
+
+    item_id = activity.get("activity_id") or activity.get("item_id")
+    if not item_id:
+        raise ValueError("school_open_answer_requires_item_id")
+    prompt = build_school_open_answer_prompt(
+        item_id=item_id,
+        skill_ids=activity["skill_ids"],
+        task_prompt=activity.get("task_prompt") or activity.get("prompt") or "",
+        passage=activity.get("passage"),
+        learner_answer=answer,
+        rubric_criteria=activity["rubric_criteria"],
+    )
+    async with llm_semaphore:
+        if _local():
+            return await ollama_structured(
+                prompt,
+                SchoolRubricEvaluation,
+                timeout=None,
+            )
+        client = get_gemini_client()
+        return await call_with_structured_output(
+            client,
+            prompt,
+            SchoolRubricEvaluation,
+        )
+
+
+__all__ = ["build_school_open_answer_prompt", "evaluate_school_open_answer"]
diff --git a/app/services/school/projection.py b/app/services/school/projection.py
new file mode 100644
index 0000000000000000000000000000000000000000..139fb07d10e3c6137368867e3b95a52c9f80da30
--- /dev/null
+++ b/app/services/school/projection.py
@@ -0,0 +1,199 @@
+"""Pure learner-profile projection for one committed School attempt."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any
+
+
+_ATTEMPT_ALPHA = {
+    "guided_check": 0.12,
+    "bridge": 0.15,
+    "independent_check": 0.30,
+    "transfer_check": 0.35,
+    "chapter_check": 0.40,
+}
+_CERTIFYING_ATTEMPTS = {"independent_check", "transfer_check", "chapter_check"}
+
+
+def _score(value: object) -> float:
+    try:
+        return max(0.0, min(1.0, float(value or 0.0)))
+    except (TypeError, ValueError):
+        return 0.0
+
+
+@dataclass(frozen=True)
+class SchoolAttemptEvidence:
+    session_id: str
+    chapter_id: str
+    level_id: str
+    module_id: str
+    task_type: str
+    focus: str
+    skill_ids: tuple[str, ...]
+    attempt_type: str
+    score: float
+    confidence: float
+    criteria: tuple[dict[str, Any], ...]
+    blockers: tuple[str, ...]
+    answer_excerpt: str
+    attempt_passed: bool
+    certified_skill_scores: dict[str, float] = field(default_factory=dict)
+
+    @classmethod
+    def from_dict(cls, raw: dict[str, Any]) -> "SchoolAttemptEvidence":
+        return cls(
+            session_id=str(raw.get("session_id") or ""),
+            chapter_id=str(raw.get("chapter_id") or ""),
+            level_id=str(raw.get("level_id") or ""),
+            module_id=str(raw.get("module_id") or raw.get("chapter_id") or ""),
+            task_type=str(raw.get("task_type") or "school_rebuild_curriculum"),
+            focus=str(raw.get("focus") or ""),
+            skill_ids=tuple(dict.fromkeys(str(value) for value in raw.get("skill_ids") or [] if str(value))),
+            attempt_type=str(raw.get("attempt_type") or ""),
+            score=_score(raw.get("score")),
+            confidence=_score(raw.get("confidence")),
+            criteria=tuple(dict(value) for value in raw.get("criteria") or [] if isinstance(value, dict)),
+            blockers=tuple(str(value) for value in raw.get("blockers") or [] if str(value)),
+            answer_excerpt=str(raw.get("answer_excerpt") or "")[:320],
+            attempt_passed=bool(raw.get("attempt_passed")),
+            certified_skill_scores={
+                str(key): _score(value)
+                for key, value in dict(raw.get("certified_skill_scores") or {}).items()
+                if str(key)
+            },
+        )
+
+
+def derive_school_projection_delta(
+    evidence: SchoolAttemptEvidence,
+    existing_rows: list[dict[str, Any]],
+) -> list[dict[str, Any]]:
+    """Derive profile upserts from rows locked by the caller."""
+
+    existing = {str(row.get("skill_id") or ""): row for row in existing_rows}
+    skill_ids = list(dict.fromkeys((*evidence.skill_ids, *evidence.certified_skill_scores)))
+    passed_without_blockers = evidence.attempt_passed and not evidence.blockers
+    certifying = evidence.attempt_type in _CERTIFYING_ATTEMPTS
+    readiness_signal = (
+        evidence.score
+        if passed_without_blockers and certifying
+        else min(evidence.score, 0.79)
+        if passed_without_blockers
+        else min(evidence.score, 0.59)
+    )
+    alpha = _ATTEMPT_ALPHA.get(evidence.attempt_type, 0.20)
+    delta: list[dict[str, Any]] = []
+
+    for skill_id in skill_ids:
+        previous = existing.get(skill_id) or {}
+        previous_attempts = int(previous.get("attempts") or 0)
+        counts_as_attempt = skill_id in evidence.skill_ids
+        previous_readiness = _score(previous.get("readiness"))
+        readiness = (
+            readiness_signal
+            if counts_as_attempt and previous_attempts == 0
+            else round((1.0 - alpha) * previous_readiness + alpha * readiness_signal, 4)
+            if counts_as_attempt
+            else previous_readiness
+        )
+        is_strong = (
+            counts_as_attempt
+            and certifying
+            and passed_without_blockers
+            and evidence.score >= 0.8
+            and readiness >= 0.65
+        )
+        certified_score = evidence.certified_skill_scores.get(skill_id)
+        has_certification_score = certified_score is not None
+        chapter_mastered = certified_score is not None and certified_score >= 0.8
+        previous_gaps = [str(value) for value in previous.get("gaps_json") or [] if str(value)]
+        gap = "" if is_strong or chapter_mastered else previous_gaps[0] if passed_without_blockers and previous_gaps else evidence.focus
+        previous_evidence = previous.get("evidence_json") if isinstance(previous.get("evidence_json"), dict) else {}
+        evidence_json = {
+            "session_id": evidence.session_id,
+            "chapter_id": evidence.chapter_id,
+            "level_id": evidence.level_id,
+            "attempt_type": evidence.attempt_type,
+            "latest_quote": evidence.answer_excerpt,
+            "criteria": list(evidence.criteria),
+            "blockers": list(evidence.blockers),
+            "evaluator_score": evidence.score,
+            "attempt_passed": evidence.attempt_passed,
+        }
+        if has_certification_score:
+            certification_evidence = {
+                "latest_certification": {
+                    "session_id": evidence.session_id,
+                    "chapter_id": evidence.chapter_id,
+                    "score": certified_score,
+                },
+            }
+            evidence_json = (
+                {**previous_evidence, **certification_evidence}
+                if not counts_as_attempt and previous
+                else {
+                    **previous_evidence,
+                    **({} if previous_evidence else evidence_json),
+                    **certification_evidence,
+                }
+            )
+        strong = is_strong or chapter_mastered
+        preserves_prior_metadata = not counts_as_attempt and bool(previous)
+        delta.append({
+            "user_id": "",
+            "domain": "school",
+            "skill_id": skill_id,
+            "module_id": (
+                previous.get("module_id")
+                if preserves_prior_metadata
+                else evidence.module_id or evidence.chapter_id
+            ),
+            "task_type": (
+                previous.get("task_type")
+                if preserves_prior_metadata
+                else evidence.task_type
+            ),
+            "mastery": 1.0 if chapter_mastered else _score(previous.get("mastery")),
+            "readiness": max(readiness, certified_score or 0.0) if chapter_mastered else readiness,
+            "confidence": (
+                previous.get("confidence")
+                if preserves_prior_metadata
+                else evidence.confidence
+            ),
+            "attempts": previous_attempts + (1 if counts_as_attempt else 0),
+            "strengths_json": (
+                previous.get("strengths_json") or []
+                if preserves_prior_metadata
+                else [evidence.focus] if strong else []
+            ),
+            "gaps_json": (
+                previous.get("gaps_json") or []
+                if preserves_prior_metadata
+                else [gap] if gap else []
+            ),
+            "evidence_json": evidence_json,
+            "recommended_next_action": (
+                previous.get("recommended_next_action") or ""
+                if preserves_prior_metadata
+                else "Continue with a new independent example."
+                if strong
+                else f"Try this skill without support: {evidence.focus}."
+                if passed_without_blockers
+                else f"Rebuild this skill: {evidence.focus}."
+            ),
+            "source_summary": (
+                previous.get("source_summary") or ""
+                if preserves_prior_metadata
+                else f"Strong {evidence.attempt_type} evidence in {evidence.chapter_id}."
+                if strong
+                else f"Supported improvement with {evidence.focus}."
+                if passed_without_blockers
+                else f"Needs more support with {evidence.focus}."
+            ),
+        })
+    return delta
+
+
+__all__ = ["SchoolAttemptEvidence", "derive_school_projection_delta"]
diff --git a/app/services/school_rebuild_learning.py b/app/services/school_rebuild_learning.py
