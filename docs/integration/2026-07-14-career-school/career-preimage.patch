+    live_kwargs = copy.deepcopy(session_kwargs)
+    live_kwargs[flow_key]["processing_answer_request"] = {
+        "status": "processing",
+        "age_seconds": 119.999,
+        "stale": False,
+    }
+
+    live = school_state_for_profile(
