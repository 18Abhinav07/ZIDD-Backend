+        pytest.fail("Refusing SCHOOL_MIGRATION_TEST_URL: must use a loopback host")
+    if os.environ.get("SCHOOL_MIGRATION_TEST_DISPOSABLE_CLUSTER", "").strip() != "1":
+        pytest.fail(
