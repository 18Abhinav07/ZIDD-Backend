+async def upsert_school_placement_report(
+    session: AsyncSession,
+    *,
+    report_id: str,
+    user_id: str,
+    profile_version_id: str,
+    placement_session_id: str,
+    placement_status: str,
+    subject_id: str,
+    target_class_no: int,
