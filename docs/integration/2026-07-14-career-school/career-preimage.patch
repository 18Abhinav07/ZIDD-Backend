+    )
+    confirmatory_template = next(
+        item
+        for band in track.bands
+        for item in band.variants
+        if item.stage == "confirmatory"
+    )
+    return tuple(
+        PlacementBand(
+            source_class_no=source_class_no,
+            variants=(
+                replace(
+                    targeted_template,
+                    item_id=f"{track.track_id}.targeted.{source_class_no}",
+                    source_class_no=source_class_no,
