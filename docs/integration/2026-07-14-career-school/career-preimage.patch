+@router.post("/onboarding/complete")
+@school_route_owner("app.services.school_rebuild_profile")
+async def complete_school_onboarding(
+    req: SchoolOnboardingCompleteIn,
+    request: Request,
+) -> dict:
+    user_id = _uid(request)
