+                                     DATE '2026-04-01', DATE '2027-03-31')
+                                """
+                            ),
+                            {"digest": "f" * 64},
+                        )
+                finally:
+                    await current_release_savepoint.rollback()
+
+                security_rows = (
+                    await connection.execute(
+                        text(
+                            """
+                            SELECT table_row.relname AS table_name,
