# ===== AI providers =====
GROQ_API_KEY=gsk_xxx
GEMINI_API_KEY=AIza_xxx

# ===== AI backend switch =====
# local -> Ollama (no quota, dev/build)   |   cloud -> Gemini + Groq (submission)
AI_BACKEND=local
OLLAMA_MODEL=qwen2.5:14b

# ===== Google OAuth =====
# Client ID only — audience for verifying Google-issued id_tokens server-side.
# The client SECRET is NEVER used here; it stays server-only inside the
# Next.js NextAuth process.
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# ===== CORS =====
# Comma-separated explicit allow-list of origins permitted to call this API.
# NEVER "*" — CORSMiddleware rejects it anyway when allow_credentials=True.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ===== Supabase — transaction pooler (port 6543) =====
# Required for app runtime even when AI_BACKEND=local/qwen.
# Raw URL from dashboard: postgresql://postgres.<ref>:<pwd>@<host>:6543/postgres
# Code swaps driver -> postgresql+asyncpg and appends ?ssl=require at runtime.
SUPABASE_POOLER_URL=postgresql://postgres.xxxxx:PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres
SUPABASE_DB_PASSWORD=xxx

# anon key — NOT used by engine (frontend only). Keep for later.
SUPABASE_ANON_KEY=

# ===== App =====
APP_ENV=dev
LOG_LEVEL=info
# Required at boot: HS256 signing secret. >=32 chars enforced when APP_ENV=prod.
ZIDD_JWT_SECRET=change-me-in-env-not-committed
# Separate signing secret for the India beta data region. It is selected whenever
# DATA_REGION=india, so beta cookies never share the default-region signing key.
ZIDD_JWT_SECRET_IND=generate_with_openssl_rand_hex_48
# Localhost-only credit top-up escape hatch. Keep false outside local testing.
ENABLE_DEV_CREDIT_GRANT=false

# ===== Session hardening =====
SESSION_TTL_SECONDS=604800
MAX_ACTIVE_SESSIONS_PER_USER=20
SESSION_TURN_LIMIT_PER_DAY=100
AUTH_GOOGLE_LIMIT_PER_MINUTE=20

# ===== Payments (Razorpay sandbox) =====
# key_id + key_secret: Razorpay Dashboard -> Test Mode -> Settings -> API Keys.
# These map to the pydantic fields razorpay_key_id / razorpay_key_secret.
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
# webhook secret: self-generated (openssl rand -hex 32). Shared between the local
# webhook simulator (scripts/dev_webhook.py) and the backend HMAC verify. NOT a
# dashboard value for local runs — Razorpay cannot POST to 127.0.0.1.
RAZORPAY_WEBHOOK_SECRET=generate_with_openssl_rand_hex_32
