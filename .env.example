# ===== AI providers =====
GROQ_API_KEY=gsk_xxx
GEMINI_API_KEY=AIza_xxx

# ===== AI backend switch =====
# local -> Ollama (no quota, dev/build)   |   cloud -> Gemini + Groq (submission)
AI_BACKEND=local
OLLAMA_MODEL=qwen2.5:14b

# ===== Supabase — transaction pooler (port 6543) =====
# Not required when AI_BACKEND=local (LocalStore SQLite is used instead).
# Raw URL from dashboard: postgresql://postgres.<ref>:<pwd>@<host>:6543/postgres
# Code swaps driver -> postgresql+asyncpg and appends ?ssl=require at runtime.
SUPABASE_POOLER_URL=postgresql://postgres.xxxxx:PASSWORD@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres
SUPABASE_DB_PASSWORD=xxx

# anon key — NOT used by engine (frontend only). Keep for later.
SUPABASE_ANON_KEY=

# ===== App =====
APP_ENV=dev
LOG_LEVEL=info
# Required at boot: HS256 signing secret. >=32 chars enforced when APP_ENV=prod.
ZIDD_JWT_SECRET=change-me-in-env-not-committed

# Local-first SQLite store (used when AI_BACKEND=local). Override for tests.
LOCAL_STORE_PATH=.zidd_local.db

# ===== Payments (Razorpay sandbox) =====
# key_id + key_secret: Razorpay Dashboard -> Test Mode -> Settings -> API Keys.
# These map to the pydantic fields razorpay_key_id / razorpay_key_secret.
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
# webhook secret: self-generated (openssl rand -hex 32). Shared between the local
# webhook simulator (scripts/dev_webhook.py) and the backend HMAC verify. NOT a
# dashboard value for local runs — Razorpay cannot POST to 127.0.0.1.
RAZORPAY_WEBHOOK_SECRET=generate_with_openssl_rand_hex_32
